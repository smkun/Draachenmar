{
  "name": "draachenmar-encyclopedia",
  "version": "1.0.0",
  "description": "An interactive encyclopedia for the Draachenmar campaign world",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "extract-content": "tsx scripts/extractContent.ts",
    "extract-structured": "tsx scripts/extractStructuredContent.ts",
    "migrate-content": "tsx scripts/migrateToApp.ts",
    "analyze-bundle": "npm run build && node tools/bundle-analyzer.js",
    "analyze-images": "node tools/analyze-image-performance.js",
    "test-accessibility": "node tools/accessibility-audit.js",
    "test-lazy-loading": "node tools/test-lazy-loading.js"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "fs-extra": "^11.3.2",
    "fuse.js": "^6.6.2",
    "glob": "^11.0.3",
    "lucide-react": "^0.263.1",
    "mammoth": "^1.11.0",
    "node.js": "^0.0.1-security",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.10.2",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "axe-core": "^4.10.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.24",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
